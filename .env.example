# PostgreSQL connection string (Neon / Supabase / Railway)
# Format: postgresql://USER:PASSWORD@HOST:PORT/DATABASE?sslmode=require
DATABASE_URL="postgresql://user:password@localhost:5432/allo_inventory?schema=public"

# Direct URL for Prisma migrations (required by some providers like Neon)
DIRECT_URL="postgresql://user:password@localhost:5432/allo_inventory?schema=public"

# Secret used to authenticate Vercel Cron requests
# Generate with: openssl rand -base64 32
CRON_SECRET="your-cron-secret-here"

# App URL (used for internal cron invocations and CORS)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Reservation TTL in minutes (default: 10)
RESERVATION_TTL_MINUTES="10"
