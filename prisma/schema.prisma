// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ---------------------------------------------------------------------------
// Warehouse – a physical fulfilment centre
// ---------------------------------------------------------------------------
model Warehouse {
  id        String   @id @default(cuid())
  name      String
  location  String
  createdAt DateTime @default(now()) @map("created_at")

  inventoryStocks InventoryStock[]
  reservations    Reservation[]

  @@map("warehouses")
}

// ---------------------------------------------------------------------------
// Product – a sellable SKU
// ---------------------------------------------------------------------------
model Product {
  id          String    @id @default(cuid())
  name        String
  sku         String    @unique
  description String?
  imageUrl    String?   @map("image_url")
  price       Decimal   @db.Decimal(10, 2)
  isActive    Boolean   @default(true) @map("is_active")
  archivedAt  DateTime? @map("archived_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  inventoryStocks InventoryStock[]
  reservations    Reservation[]

  @@map("products")
}

// ---------------------------------------------------------------------------
// InventoryStock – available units of a product at a warehouse
//
// availableQuantity = totalQuantity - reservedQuantity
//
// Invariant: reservedQuantity <= totalQuantity
// Invariant: reservedQuantity >= 0
// ---------------------------------------------------------------------------
model InventoryStock {
  id               String   @id @default(cuid())
  productId        String   @map("product_id")
  warehouseId      String   @map("warehouse_id")
  totalQuantity    Int      @default(0) @map("total_quantity")
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  updatedAt        DateTime @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Cascade)

  adjustments InventoryAdjustment[]

  // A product can only have one stock record per warehouse
  @@unique([productId, warehouseId])
  // Index for the most common query pattern
  @@index([productId, warehouseId])
  @@index([productId])
  @@map("inventory_stocks")
}

// ---------------------------------------------------------------------------
// Reservation – a temporary hold on inventory units
// ---------------------------------------------------------------------------
model Reservation {
  id             String            @id @default(cuid())
  productId      String            @map("product_id")
  warehouseId    String            @map("warehouse_id")
  quantity       Int
  unitPrice      Decimal           @default(0.00) @db.Decimal(10, 2) @map("unit_price")
  status         ReservationStatus @default(PENDING)
  expiresAt      DateTime          @map("expires_at")
  confirmedAt    DateTime?         @map("confirmed_at")
  releasedAt     DateTime?         @map("released_at")
  // Idempotency key supplied by the client (Idempotency-Key header)
  idempotencyKey String?           @unique @map("idempotency_key")
  // Free-form metadata (e.g., user_id, session_id, order_ref)
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at")
  updatedAt      DateTime          @updatedAt @map("updated_at")

  product   Product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  warehouse Warehouse @relation(fields: [warehouseId], references: [id], onDelete: Restrict)

  // Cron job queries expired PENDING reservations heavily
  @@index([status, expiresAt])
  @@index([productId, warehouseId])
  @@index([status, confirmedAt])
  @@index([warehouseId, status])
  @@map("reservations")
}

enum ReservationStatus {
  PENDING   // hold is active
  CONFIRMED // payment succeeded, stock permanently decremented
  RELEASED  // released early (payment failed / user cancelled)
  EXPIRED   // hold expired without confirmation
}

// ---------------------------------------------------------------------------
// IdempotencyRecord – caches responses for idempotent requests
// ---------------------------------------------------------------------------
model IdempotencyRecord {
  id           String   @id @default(cuid())
  key          String   @unique
  statusCode   Int      @map("status_code")
  responseBody Json     @map("response_body")
  createdAt    DateTime @default(now()) @map("created_at")

  @@index([key])
  @@map("idempotency_records")
}

// ---------------------------------------------------------------------------
// InventoryAdjustment – logs administrative adjustments of stock levels
// ---------------------------------------------------------------------------
model InventoryAdjustment {
  id          String   @id @default(cuid())
  stockId     String   @map("stock_id")
  action      String   // "RESTOCK", "DAMAGE", "CORRECTION", "TRANSFER_IN", "TRANSFER_OUT"
  quantity    Int      // quantity added or subtracted
  reason      String?
  adminName   String   @default("Admin") @map("admin_name")
  createdAt   DateTime @default(now()) @map("created_at")

  stock       InventoryStock @relation(fields: [stockId], references: [id], onDelete: Cascade)

  @@map("inventory_adjustments")
}

// ---------------------------------------------------------------------------
// UserRole – Authentication roles for isolated portals
// ---------------------------------------------------------------------------
enum UserRole {
  USER
  SERVICE_PROVIDER
  ADMIN
}

// ---------------------------------------------------------------------------
// User – Registered dashboard and storefront users
// ---------------------------------------------------------------------------
model User {
  id        String   @id @default(cuid())
  email     String   @unique
  password  String   // Secure salted PBKDF2 hash
  name      String
  role      UserRole
  createdAt DateTime @default(now()) @map("created_at")

  @@map("users")
}

